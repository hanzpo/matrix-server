# Real secrets / config — ONLY the .example templates are tracked
mcp/.env
caddy/Caddyfile
bridges/**/config.yaml
bridges/**/registration.yaml

# Runtime state / data — never commit
**/*.db
**/*.db-shm
**/*.db-wal
**/logs/
tuwunel/data/
caddy/data/
caddy/config/

# misc
.DS_Store

# backfill runtime state
backfill/__pycache__/
backfill/*.log
backfill/*.jsonl
backfill/progress.json
backfill/state.json

# editor/backup litter
*.bak
*.bak2
__pycache__/
*.pyc
