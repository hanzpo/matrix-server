matrix.hanzpo.com {
	# MCP server, gated behind an unguessable path prefix (Caddy strips it),
	# with real auth (bearer token) enforced inside the app.
	handle_path /CHANGEME_SECRET_PATH/* {
		reverse_proxy mcp-matrix:8000
	}

	# Everything else is the Matrix homeserver.
	handle {
		reverse_proxy tuwunel:8008
	}
}

# Grindstone (interview prep). Generate the hash with: caddy hash-password
study.hanzpo.com {
	basic_auth {
		hanz CHANGEME_BCRYPT_HASH
	}
	reverse_proxy grindstone:8321
}
