# MCP server config — copy to mcp/.env, fill in, then `chmod 600 mcp/.env`.

# Internal URL of the homeserver (docker network name). Usually leave as-is.
MATRIX_HS=http://tuwunel:8008

# Public hostname Caddy serves (used for the DNS-rebinding allowlist).
PUBLIC_HOST=matrix.hanzpo.com

# Bearer token the bot must send on every request.
# Generate:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-43
MCP_BEARER=CHANGEME_GENERATE_A_LONG_RANDOM_TOKEN

# Second factor: pin to your Poke account's X-Poke-User-Id.
# Leave blank on first run, watch `docker logs matrix-mcp-matrix-1` for
# "POKE_USER_ID=..." after one Poke request, then set it here and restart.
POKE_USER_ID=

# Dedicated, revocable Matrix device token. DO NOT paste a token here by hand —
# run `mcp/mint-token.sh`, which logs in as your user (device_id=mcp-bot) and
# writes MATRIX_TOKEN into the real .env for you.
MATRIX_TOKEN=CHANGEME_RUN_MINT_TOKEN_SH

# Global rate limit (requests per window seconds).
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60
